# Copie para .env e preencha com valores reais.

# Senha do usuario 'paperless' no Postgres.
POSTGRES_PASSWORD=troque-me

# Chave secreta do Django usada pelo paperless. Gere uma aleatoria, ex.:
#   openssl rand -base64 60 | tr -d '\n'
PAPERLESS_SECRET_KEY=troque-me

# URL publica de acesso ao paperless.
PAPERLESS_URL=https://troque-me.exemplo.com.br
